# Copy to .env and fill in. Only DATABASE_URL and JWT_SECRET_KEY are required outside development;
# in development both fall back to a local SQLite DB and a random key.

ENVIRONMENT=development            # development | staging | production
HOST=127.0.0.1
PORT=8000

# Postgres (asyncpg). Plain postgres:// / postgresql:// URLs are converted automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/theravox
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Frontend origin (OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Optional integrations
GROQ_API_KEY=                      # AI companion chat + journal prompts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SENTRY_DSN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
