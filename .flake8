[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude = .git, __pycache__, .venv, venv, frontend/node_modules
# Prose content (journal prompts, quotes, program and recommendation copy)
per-file-ignores =
    app/api/journal.py: E501
    app/api/postcard.py: E501
    app/services/program_service.py: E501
    app/services/recommendation_service.py: E501
