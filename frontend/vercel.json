{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "../static",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://theravox-ai-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
